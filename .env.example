# Banco PostgreSQL (no Supabase: Project Settings > Database > Connection string, modo "Session pooler")
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/seven_demo
# Em Supabase/Render é preciso SSL:
DB_SSL=0

# Chave que assina o login (use um texto longo e aleatório)
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Opcionais
PORT=3001
CORS_ORIGIN=
LIMITE_POR_MINUTO=300
TRUST_PROXY=1
# Notificações no celular (opcional; sem elas o restante funciona normalmente)
NOTIF_DESLIGADO=1
VAPID_SUBJECT=mailto:demo@demo.local
